{
  "name": "botpass",
  "version": "0.1.0",
  "private": true,
  "description": "Open Claim event attendance registry on BOT Chain.",
  "license": "MIT",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "clean": "hardhat clean",
    "compile": "hardhat compile",
    "test": "hardhat test",
    "deploy:testnet:inspect": "node scripts/deploy.js testnet --inspect",
    "deploy:testnet:preflight": "node scripts/preflight.js testnet",
    "deploy:testnet": "node scripts/deploy.js testnet --authorize",
    "deploy:mainnet:inspect": "node scripts/deploy.js mainnet --inspect",
    "deploy:mainnet:preflight": "node scripts/preflight.js mainnet",
    "deploy:mainnet": "node scripts/deploy.js mainnet --authorize",
    "event:testnet:prepare": "node scripts/demo-events.js testnet --inspect",
    "event:testnet": "node scripts/demo-events.js testnet --authorize",
    "integration:local": "hardhat run scripts/local-integration.js --network hardhat",
    "frontend:generate": "node scripts/generate-frontend-config.js",
    "frontend:dev": "npm run frontend:generate && vite --config frontend/vite.config.mjs",
    "frontend:build": "npm run frontend:generate && vite build --config frontend/vite.config.mjs",
    "frontend:preview": "vite preview --config frontend/vite.config.mjs",
    "frontend:validate": "node scripts/validate-frontend.js",
    "frontend:validate:a11y": "node scripts/validate-frontend-accessibility.js",
    "frontend:validate:dist": "node scripts/validate-pages-build.js",
    "repository:validate": "node scripts/validate-repository-shape.js",
    "verification:testnet:prepare": "node scripts/prepare-verification.js testnet",
    "verification:mainnet:prepare": "node scripts/prepare-verification.js mainnet",
    "build": "npm run frontend:build"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-chai-matchers": "2.1.2",
    "@nomicfoundation/hardhat-ethers": "3.1.3",
    "@openzeppelin/contracts": "5.0.2",
    "chai": "4.5.0",
    "ethers": "6.17.0",
    "hardhat": "2.29.0",
    "vite": "8.1.5"
  }
}
